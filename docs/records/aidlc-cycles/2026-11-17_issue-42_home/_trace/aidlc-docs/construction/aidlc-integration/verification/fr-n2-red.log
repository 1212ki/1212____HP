    .site-header .logo {
      font-family: var(--font-display), sans-serif;
      font-size: 20px;
      line-height: 30px;
      letter-spacing: 0;
      font-weight: 500;
      gap: var(--space-12);
      flex-wrap: nowrap;
      white-space: nowrap;
    }
    .site-header .logo .pc-only { font-size: 14px; line-height: 22px; letter-spacing: 0; font-weight: 400; }
    .site-header .logo::after { display: none; }
    .site-header nav ul { gap: var(--space-32); flex-wrap: nowrap; }
    .site-header nav ul li a {
      display: block;
      padding: 0;
      border: 0;
      border-radius: 0;
      font-size: 14px;
      line-height: 22px;
      letter-spacing: .04em;
      font-weight: 500;
      text-transform: none;
      color: var(--ink-muted);
      background: none;
    }
    .site-header nav ul li a:hover,
    .site-header nav ul li a.active { color: var(--ink); background: none; }
    .site-header .nav-toggle {
      padding: 0;
