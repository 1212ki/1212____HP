    .site-header .nav-toggle-icon { display: none; }
    .site-header :focus-visible, .site-footer :focus-visible, .site-home :focus-visible { outline-color: var(--ink); }
    .site-header ::selection, .site-footer ::selection { background: var(--paper-deep); color: var(--ink); }
    .site-footer {
      background: var(--paper);
