    <body>
      <div id="app">
        <!-- ヘッダー: 左に「1212 Admin」、右に接続の表示（Local Modeだけ「JSONを書き出す」も） -->
        <header class="header">
          <h1 class="logo">1212 <span class="accent">Admin</span></h1>
          <div class="header-right">
            <p class="header-meta" id="modeBadge">Local Mode</p>
            <button class="save-btn" id="saveBtn" data-admin-mutation onclick="saveData()" hidden>保存</button>
          </div>
        </header>
        <div class="connection-banner" id="connectionBanner">データ接続を初期化中...</div>
    
        <!-- タブナビ -->
        <nav class="tab-nav">
          <button class="tab-btn" data-tab="site">Site</button>
          <button class="tab-btn" data-tab="news">News</button>
          <button class="tab-btn active" data-tab="live">Live</button>
          <button class="tab-btn" data-tab="music">Music</button>
          <button class="tab-btn" data-tab="profile">Profile</button>
        </nav>
    
        <!-- Siteタブ: 一覧のない1画面。入力はこの画面の中だけに持ち、「保存して公開」で公開データへ反映する -->
        <section class="tab-content occ-tab occ-page" id="site-tab">
          <div class="occ-page-head">
            <h2 class="occ-page-title">Site</h2>
            <span class="occ-status" id="site-editor-status" role="status" aria-live="polite"></span>
            <div class="occ-save" id="site-editor-actions" hidden>
              <p class="occ-error" id="site-editor-error" role="alert"></p>
              <button type="button" class="btn btn-primary occ-save-btn" id="site-save-btn" data-admin-mutation>保存して公開</button>
            </div>
          </div>
    
          <div class="occ-page-body">
            <section class="occ-panel" aria-labelledby="site-home-heading">
              <h3 class="occ-panel-heading" id="site-home-heading">Home</h3>
              <div class="form-group occ-field">
                <label for="site-featured-release-id">顔にする作品</label>
                <select id="site-featured-release-id" class="select" data-admin-mutation>
                  <option value="">自動（最新のリリース）</option>
                </select>
              </div>
              <div class="occ-hero-field">
                <p class="occ-field-label" id="site-hero-image-label">共有時の画像</p>
                <p class="field-hint">ライブの画像がない時、共有時の画像に使います。Homeには作品のジャケットを表示します。</p>
                <div id="site-hero-image-form"></div>
              </div>
            </section>
    
            <section class="occ-panel" aria-labelledby="site-links-heading">
              <h3 class="occ-panel-heading" id="site-links-heading">Home Links</h3>
              <div class="form-group occ-field">
                <label for="site-link-bandcamp">Bandcamp</label>
                <input type="url" id="site-link-bandcamp" class="text-input" data-admin-mutation placeholder="https://...">
              </div>
              <div class="form-group occ-field">
                <label for="site-link-youtube">YouTube</label>
                <input type="url" id="site-link-youtube" class="text-input" data-admin-mutation placeholder="https://...">
              </div>
              <div class="form-group occ-field">
                <label for="site-link-x">X</label>
                <input type="url" id="site-link-x" class="text-input" data-admin-mutation placeholder="https://...">
              </div>
              <div class="form-group occ-field">
                <label for="site-link-instagram">Instagram</label>
                <input type="url" id="site-link-instagram" class="text-input" data-admin-mutation placeholder="https://...">
              </div>
              <div class="form-group occ-field">
                <label for="site-link-note">note</label>
                <input type="url" id="site-link-note" class="text-input" data-admin-mutation placeholder="https://...">
              </div>
            </section>
    
            <section class="occ-panel" aria-labelledby="site-footer-heading">
              <h3 class="occ-panel-heading" id="site-footer-heading">Footer</h3>
              <div class="form-group occ-field">
                <label for="site-footer-text">フッター文言（空なら既定のまま）</label>
                <input type="text" id="site-footer-text" class="text-input" data-admin-mutation placeholder="&copy; ...">
              </div>
            </section>
    
            <section class="occ-panel" aria-labelledby="site-contact-heading">
