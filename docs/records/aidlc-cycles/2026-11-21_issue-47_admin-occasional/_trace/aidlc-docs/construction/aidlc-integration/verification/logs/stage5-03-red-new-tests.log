                  <h3 class="occ-editor-heading" id="news-editor-heading"></h3>
                  <div class="occ-save" id="news-editor-actions" hidden>
                    <span class="occ-status occ-status-wide" id="news-editor-status-wide" role="status" aria-live="polite"></span>
                    <p class="occ-error" id="news-editor-error" role="alert"></p>
                    <button type="button" class="btn btn-primary occ-save-btn" id="news-save-btn" data-admin-mutation>保存して公開</button>
