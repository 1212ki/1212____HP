    <!DOCTYPE html>
    <html lang="ja">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
      <title>1212 HP Admin</title>
      <link rel="stylesheet" href="../assets/css/1212-music.tokens.css">
      <link rel="stylesheet" href="style.css?v=20260816-22">
    </head>
    <body>
      <div id="app">
        <!-- ヘッダー -->
        <header class="header">
          <div>
            <h1 class="logo">1212 <span class="accent">Admin</span></h1>
            <p class="header-meta" id="modeBadge">Local Mode</p>
          </div>
          <button class="save-btn" id="saveBtn" data-admin-mutation onclick="saveData()">保存</button>
        </header>
        <div class="connection-banner" id="connectionBanner">データ接続を初期化中...</div>
    
        <!-- タブナビ -->
        <nav class="tab-nav">
          <button class="tab-btn" data-tab="site">Site</button>
          <button class="tab-btn" data-tab="news">News</button>
          <button class="tab-btn active" data-tab="live">Live</button>
          <button class="tab-btn" data-tab="youtube">YouTube</button>
          <button class="tab-btn" data-tab="discography">Disco</button>
          <button class="tab-btn" data-tab="profile">Profile</button>
        </nav>
    
        <!-- Siteタブ -->
        <section class="tab-content" id="site-tab">
          <div class="section-header">
            <h2>Site</h2>
          </div>
    
          <div class="subsection">
            <h3>Home</h3>
            <div class="form-group">
              <label for="site-featured-release-id">顔にする作品</label>
              <select id="site-featured-release-id" class="select" data-admin-mutation>
                <option value="">自動（最新のリリース）</option>
              </select>
            </div>
            <label>共有時の画像</label>
            <p class="field-hint">ライブの画像がない時、共有時の画像に使います。Homeには作品のジャケットを表示します。</p>
            <div id="site-hero-image-form"></div>
          </div>
    
          <div class="subsection">
            <h3>Home Links</h3>
            <div class="form-group">
              <label>Bandcamp</label>
              <input type="url" id="site-link-bandcamp" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>YouTube</label>
              <input type="url" id="site-link-youtube" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>X</label>
              <input type="url" id="site-link-x" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>Instagram</label>
              <input type="url" id="site-link-instagram" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>note</label>
              <input type="url" id="site-link-note" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
          </div>
    
          <div class="subsection">
            <h3>Footer</h3>
            <div class="form-group">
              <label>フッター文言（空なら既定のまま）</label>
              <input type="text" id="site-footer-text" class="text-input" data-admin-mutation placeholder="&copy; ...">
            </div>
          </div>
    
          <div class="subsection">
            <h3>Contact</h3>
            <div class="form-group">
              <label>導入文</label>
              <textarea id="contact-intro-text" class="textarea" data-admin-mutation rows="3" placeholder="お問い合わせは..."></textarea>
            </div>
            <div class="form-group">
              <label>Form Action（Formspree URL）</label>
              <input type="url" id="contact-form-action" class="text-input" data-admin-mutation placeholder="https://formspree.io/f/...">
            </div>
          </div>
        </section>
    
        <!-- Newsタブ -->
        <section class="tab-content" id="news-tab">
          <div class="section-header">
            <h2>News</h2>
            <button class="add-btn" id="news-add-btn" data-admin-mutation onclick="addNews()">+ 追加</button>
          </div>
          <div class="items-list" id="news-list"></div>
        </section>
    
        <!-- Liveタブ -->
        <section class="tab-content active" id="live-tab">
          <div class="section-header">
            <h2>Live</h2>
            <button class="add-btn live-primary-action" id="live-add-btn" data-admin-mutation onclick="addLive()">+ 新規Live</button>
          </div>
          <div class="live-workspace" id="live-workspace">
            <div class="live-workspace-tabs" role="tablist" aria-label="Live管理">
              <button type="button" id="live-workspace-page-tab" class="live-workspace-tab is-active" role="tab" data-live-workspace-view="page" aria-controls="live-workspace-page-panel" aria-selected="true" tabindex="0">Liveページ</button>
              <button type="button" id="live-workspace-reservations-tab" class="live-workspace-tab" role="tab" data-live-workspace-view="reservations" aria-controls="live-workspace-reservations-panel" aria-selected="false" tabindex="-1">予約管理</button>
            </div>
    
            <section id="live-workspace-page-panel" class="live-workspace-panel" role="tabpanel" data-live-workspace-panel="page" aria-labelledby="live-workspace-page-tab">
              <div id="live-page-primary">
                <div class="live-page-toolbar">
                  <div class="live-list-tabs" role="tablist" aria-label="公演一覧">
                    <button type="button" id="live-list-upcoming-tab" class="live-list-tab is-active" role="tab" data-live-list-view="upcoming" aria-controls="live-list-upcoming-panel" aria-selected="true" tabindex="0">開催予定</button>
                    <button type="button" id="live-list-past-tab" class="live-list-tab" role="tab" data-live-list-view="past" aria-controls="live-list-past-panel" aria-selected="false" tabindex="-1">公演終了</button>
                  </div>
                  <button type="button" id="live-ticket-settings-open" class="live-workspace-utility" aria-controls="live-ticket-settings-panel" aria-expanded="false">Ticket Page共通設定</button>
                </div>
    
                <div class="live-master-detail" id="live-master-detail">
                  <div class="live-master-pane" id="live-master-pane">
                    <section id="live-list-upcoming-panel" class="live-list-panel" role="tabpanel" data-live-list-panel="upcoming" aria-labelledby="live-list-upcoming-tab">
                      <div class="items-list" id="live-upcoming-list"></div>
                    </section>
                    <section id="live-list-past-panel" class="live-list-panel" role="tabpanel" data-live-list-panel="past" aria-labelledby="live-list-past-tab" hidden>
                      <div class="items-list" id="live-past-list"></div>
                    </section>
                  </div>
    
                  <section class="live-editor-pane" id="live-editor-pane" aria-labelledby="live-editor-heading">
                    <header class="live-editor-header">
                      <button type="button" class="live-editor-back" id="live-editor-back" onclick="closeLiveEditor()" hidden>‹ Live一覧</button>
                      <div class="live-editor-title-group">
                        <p class="live-workspace-eyebrow" id="live-editor-context">選択中Live</p>
                        <h3 id="live-editor-heading">Liveを選択</h3>
                      </div>
                      <span class="live-editor-save-status" id="live-editor-save-status" aria-live="polite"></span>
                    </header>
                    <div class="live-editor-body" id="live-editor-body">
                      <div class="empty-state live-editor-empty"><p>一覧からLiveを選択するか、新規Liveを追加してください。</p></div>
                    </div>
                  </section>
                </div>
              </div>
    
              <section id="live-ticket-settings-panel" class="live-ticket-settings-panel" role="region" aria-labelledby="live-ticket-settings-title" hidden>
                <div class="section-header compact">
                  <div>
                    <p class="live-workspace-eyebrow">Liveページ共通</p>
                    <h3 id="live-ticket-settings-title">Ticket Page共通設定</h3>
                  </div>
                  <button type="button" id="live-ticket-settings-close" class="live-workspace-utility">Liveページへ戻る</button>
                </div>
                <div class="subsection">
                  <h3>Ticket Page（表示文言）</h3>
                  <div class="form-group">
                    <label>完了文（空なら既定のまま）</label>
                    <textarea id="ticket-complete-text" class="textarea" data-admin-mutation rows="2" placeholder="予約しました..."></textarea>
                  </div>
                </div>
                <div class="subsection">
                  <h3>Ticket Page（表示項目）</h3>
                  <div class="checkbox-group">
                    <input type="checkbox" id="ticket-field-quantity" data-admin-mutation>
                    <label for="ticket-field-quantity">Quantity（枚数）を表示</label>
                  </div>
                  <div class="form-group">
                    <label>枚数 ラベル（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-label-quantity" class="text-input" data-admin-mutation placeholder="枚数">
                  </div>
    
                  <div class="checkbox-group">
                    <input type="checkbox" id="ticket-field-message" data-admin-mutation>
                    <label for="ticket-field-message">備考（任意）を表示</label>
                  </div>
                  <div class="form-group">
                    <label>備考 ラベル（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-label-message" class="text-input" data-admin-mutation placeholder="備考">
                  </div>
                  <div class="form-group">
                    <label>備考 プレースホルダ（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-placeholder-message" class="text-input" data-admin-mutation placeholder="例: 取り置き名義が別の場合など">
                  </div>
    
                  <div class="form-group">
                    <label>送信ボタン文言（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-submit-label" class="text-input" data-admin-mutation placeholder="予約する">
                  </div>
                </div>
              </section>
            </section>
    
            <section id="live-workspace-reservations-panel" class="live-workspace-panel" role="tabpanel" data-live-workspace-panel="reservations" aria-labelledby="live-workspace-reservations-tab" hidden>
              <div class="live-reservations-panel">
              <div class="section-header compact">
                <h3>横断予約台帳</h3>
                <button type="button" class="add-btn" onclick="downloadTicketsCsv()">CSV</button>
              </div>
              <div class="form-group">
                <label for="tickets-live-filter">フィルタ</label>
                <div class="filters">
                  <select id="tickets-live-filter" class="select" onchange="loadTickets()"></select>
                  <select id="tickets-status-filter" class="select" onchange="loadTickets()">
                    <option value="">全ステータス</option>
                    <option value="pending" selected>未対応</option>
                    <option value="handled">対応済み</option>
                    <option value="cancelled">キャンセル</option>
                  </select>
                </div>
              </div>
              <div class="items-list" id="tickets-list"></div>
              </div>
            </section>
          </div>
        </section>
    
        <!-- YouTubeタブ -->
        <section class="tab-content" id="youtube-tab">
          <div class="section-header">
            <h2>YouTube</h2>
            <button class="add-btn" id="youtube-add-musicVideos-btn" data-admin-mutation onclick="addYouTubeVideo('musicVideos')">+ 追加</button>
          </div>
    
          <div class="subsection">
            <h3>Channel URL</h3>
            <input type="url" id="youtube-channel-url" class="text-input" data-admin-mutation placeholder="https://www.youtube.com/@...">
          </div>
    
          <div class="subsection">
            <h3>Music Video</h3>
            <div class="items-list" id="youtube-musicVideos-list"></div>
            <button class="add-btn small" id="youtube-add-musicVideos-secondary-btn" data-admin-mutation onclick="addYouTubeVideo('musicVideos')">+ 追加</button>
          </div>
    
          <div class="subsection">
            <h3>Live Movie</h3>
            <div class="items-list" id="youtube-liveMovies-list"></div>
            <button class="add-btn small" id="youtube-add-liveMovies-btn" data-admin-mutation onclick="addYouTubeVideo('liveMovies')">+ 追加</button>
          </div>
    
          <div class="subsection">
            <h3>Demo</h3>
            <div class="items-list" id="youtube-demos-list"></div>
            <button class="add-btn small" id="youtube-add-demos-btn" data-admin-mutation onclick="addYouTubeVideo('demos')">+ 追加</button>
          </div>
        </section>
    
        <!-- Discographyタブ -->
        <section class="tab-content" id="discography-tab">
          <div class="section-header">
            <h2>Discography</h2>
            <button class="add-btn" id="discography-add-btn" data-admin-mutation onclick="addDiscography()">+ 追加</button>
          </div>
          <div class="subsection">
            <h3>Digital Release</h3>
            <div class="items-list" id="disc-digital-list"></div>
          </div>
          <div class="subsection">
            <h3>宅録Demo</h3>
            <div class="items-list" id="disc-demo-list"></div>
          </div>
        </section>
    
        <!-- Profileタブ -->
        <section class="tab-content" id="profile-tab">
          <div class="section-header">
            <h2>Profile</h2>
          </div>
          <div id="profile-image-form"></div>
          <div class="form-group">
            <label>プロフィールテキスト</label>
            <textarea id="profile-text" class="textarea" data-admin-mutation rows="10" placeholder="プロフィール本文"></textarea>
          </div>
          <div class="subsection">
            <h3>SNSリンク</h3>
            <div class="items-list" id="profile-links-list"></div>
            <button class="add-btn small" id="profile-link-add-btn" data-admin-mutation onclick="addProfileLink()">+ リンク追加</button>
          </div>
