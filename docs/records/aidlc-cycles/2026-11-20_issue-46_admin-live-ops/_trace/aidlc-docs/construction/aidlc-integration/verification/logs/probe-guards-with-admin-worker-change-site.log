                    </div>
                  </section>
                </div>
              </div>
    
              <section id="live-ticket-settings-panel" class="live-ticket-settings-panel" role="region" aria-labelledby="live-ticket-settings-title" hidden>
                <div class="section-header compact">
                  <div>
                    <p class="live-workspace-eyebrow">Liveページ共通</p>
                    <h3 id="live-ticket-settings-title">Ticket Page共通設定</h3>
                  </div>
                  <button type="button" id="live-ticket-settings-close" class="live-workspace-utility">Liveページへ戻る</button>
                </div>
                <div class="subsection">
                  <h3>Ticket Page（表示文言）</h3>
                  <div class="form-group">
                    <label>完了文（空なら既定のまま）</label>
                    <textarea id="ticket-complete-text" class="textarea" data-admin-mutation rows="2" placeholder="予約しました..."></textarea>
                  </div>
                </div>
                <div class="subsection">
                  <h3>Ticket Page（表示項目）</h3>
                  <div class="checkbox-group">
                    <input type="checkbox" id="ticket-field-quantity" data-admin-mutation>
                    <label for="ticket-field-quantity">Quantity（枚数）を表示</label>
                  </div>
                  <div class="form-group">
                    <label>枚数 ラベル（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-label-quantity" class="text-input" data-admin-mutation placeholder="枚数">
                  </div>
    
                  <div class="checkbox-group">
                    <input type="checkbox" id="ticket-field-message" data-admin-mutation>
                    <label for="ticket-field-message">備考（任意）を表示</label>
                  </div>
                  <div class="form-group">
                    <label>備考 ラベル（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-label-message" class="text-input" data-admin-mutation placeholder="備考">
                  </div>
                  <div class="form-group">
                    <label>備考 プレースホルダ（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-placeholder-message" class="text-input" data-admin-mutation placeholder="例: 取り置き名義が別の場合など">
                  </div>
    
                  <div class="form-group">
                    <label>送信ボタン文言（空なら既定のまま）</label>
                    <input type="text" id="ticket-field-submit-label" class="text-input" data-admin-mutation placeholder="予約する">
                  </div>
                </div>
              </section>
            </section>
    
            <section id="live-workspace-reservations-panel" class="live-workspace-panel" role="tabpanel" data-live-workspace-panel="reservations" aria-labelledby="live-workspace-reservations-tab" hidden>
