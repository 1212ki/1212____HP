    <!DOCTYPE html>
    <html lang="ja">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
      <title>1212 HP Admin</title>
      <link rel="stylesheet" href="../assets/css/1212-music.tokens.css">
      <link rel="stylesheet" href="style.css?v=20260816-22">
    </head>
    <body>
      <div id="app">
        <!-- ヘッダー -->
        <header class="header">
          <div>
            <h1 class="logo">1212 <span class="accent">Admin</span></h1>
            <p class="header-meta" id="modeBadge">Local Mode</p>
          </div>
          <button class="save-btn" id="saveBtn" data-admin-mutation onclick="saveData()">保存</button>
        </header>
        <div class="connection-banner" id="connectionBanner">データ接続を初期化中...</div>
    
        <!-- タブナビ -->
        <nav class="tab-nav">
          <button class="tab-btn" data-tab="site">Site</button>
          <button class="tab-btn" data-tab="news">News</button>
          <button class="tab-btn active" data-tab="live">Live</button>
          <button class="tab-btn" data-tab="youtube">YouTube</button>
          <button class="tab-btn" data-tab="discography">Disco</button>
          <button class="tab-btn" data-tab="profile">Profile</button>
        </nav>
    
        <!-- Siteタブ -->
        <section class="tab-content" id="site-tab">
          <div class="section-header">
            <h2>Site</h2>
          </div>
    
          <div class="subsection">
            <h3>Home</h3>
            <div class="form-group">
              <label for="site-featured-release-id">顔にする作品</label>
              <select id="site-featured-release-id" class="select" data-admin-mutation>
                <option value="">自動（最新のリリース）</option>
              </select>
            </div>
            <label>共有時の画像</label>
            <p class="field-hint">ライブの画像がない時、共有時の画像に使います。Homeには作品のジャケットを表示します。</p>
            <div id="site-hero-image-form"></div>
          </div>
    
          <div class="subsection">
            <h3>Home Links</h3>
            <div class="form-group">
              <label>Bandcamp</label>
              <input type="url" id="site-link-bandcamp" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>YouTube</label>
              <input type="url" id="site-link-youtube" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>X</label>
              <input type="url" id="site-link-x" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>Instagram</label>
              <input type="url" id="site-link-instagram" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
            <div class="form-group">
              <label>note</label>
              <input type="url" id="site-link-note" class="text-input" data-admin-mutation placeholder="https://...">
            </div>
          </div>
    
          <div class="subsection">
            <h3>Footer</h3>
            <div class="form-group">
              <label>フッター文言（空なら既定のまま）</label>
              <input type="text" id="site-footer-text" class="text-input" data-admin-mutation placeholder="&copy; ...">
            </div>
          </div>
    
          <div class="subsection">
            <h3>Contact</h3>
            <div class="form-group">
              <label>導入文</label>
              <textarea id="contact-intro-text" class="textarea" data-admin-mutation rows="3" placeholder="お問い合わせは..."></textarea>
            </div>
            <div class="form-group">
              <label>Form Action（Formspree URL）</label>
              <input type="url" id="contact-form-action" class="text-input" data-admin-mutation placeholder="https://formspree.io/f/...">
            </div>
          </div>
        </section>
    
        <!-- Newsタブ -->
        <section class="tab-content" id="news-tab">
          <div class="section-header">
            <h2>News</h2>
